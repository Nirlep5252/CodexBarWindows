<Project Sdk="WixToolset.Sdk/6.0.2">
  <PropertyGroup>
    <OutputName>CodexBarWindows-$(ProductVersion)-win-x64</OutputName>
    <OutputType>Package</OutputType>
    <ProductVersion Condition="'$(ProductVersion)' == ''">0.3.2</ProductVersion>
    <PublishDir Condition="'$(PublishDir)' == ''">..\bin\publish\win-x64</PublishDir>
    <DefineConstants>ProductVersion=$(ProductVersion);PublishDir=$(PublishDir)</DefineConstants>
    <SuppressIces>ICE91</SuppressIces>
  </PropertyGroup>
</Project>
