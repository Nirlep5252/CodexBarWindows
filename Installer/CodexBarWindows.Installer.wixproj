<Project Sdk="WixToolset.Sdk/6.0.2">
  <PropertyGroup>
    <OutputName>CodexBarWindows-$(ProductVersion)-win-x64</OutputName>
    <OutputType>Package</OutputType>
    <ProductVersion Condition="'$(ProductVersion)' == ''">0.4.1</ProductVersion>
    <PublishDir Condition="'$(PublishDir)' == ''">..\bin\publish\win-x64</PublishDir>
    <DefineConstants>ProductVersion=$(ProductVersion);PublishDir=$(PublishDir)</DefineConstants>
    <SuppressIces>ICE91</SuppressIces>
    <!-- The WiX SDK globs every .wxs in this folder, and PackageWinUI.wxs is the WinUI 3 shell's
         separate package (see CodexBar.WinUI.Installer.wixproj). Two <Package> elements in one
         build is error WIX0089, so this project names its single source explicitly. A
         <Compile Remove> does not work: the SDK's glob runs after the project body. -->
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Package.wxs" />
  </ItemGroup>
</Project>
