<?xml version="1.0" encoding="utf-8" ?>
<!--
  Unpackaged, self-contained x64 publish of the WinUI 3 shell.

  There is deliberately NO PublishSingleFile here, unlike the WinForms app's publish in
  Scripts/build-installer.ps1. WindowsAppSDKSelfContained lays down the Windows App Runtime's
  native DLLs (Microsoft.UI.Xaml, CoreMessaging, WindowsAppRuntime, MRM, the DWrite/Direct2D
  shims) next to the exe, and the WinUI activation path loads several of them by PATH rather
  than through the host, so bundling them into a single-file extract does not reliably work.
  The result is a FOLDER of roughly 220 MB, which is expected and accepted.

  Publish with:
      dotnet publish CodexBar.WinUI\CodexBar.WinUI.csproj -p:PublishProfile=win-x64
  or, with the version stamping the installer wants, Scripts\build-installer-winui.ps1.
-->
<Project>
  <PropertyGroup>
    <PublishProtocol>FileSystem</PublishProtocol>
    <Configuration>Release</Configuration>
    <Platform>x64</Platform>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <WindowsPackageType>None</WindowsPackageType>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishReadyToRun>false</PublishReadyToRun>
    <PublishDir>$(MSBuildThisFileDirectory)..\..\..\bin\publish-winui\win-x64\</PublishDir>
  </PropertyGroup>
</Project>
