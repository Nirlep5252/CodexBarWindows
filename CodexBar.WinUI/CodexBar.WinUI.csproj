<?xml version="1.0" encoding="UTF-8" ?>
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      WinUI 3 shell for CodexBar. Built SIDE BY SIDE with the WinForms app
      (CodexBarWindows.csproj) until the cutover; both consume CodexBar.Core.
    -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <OutputType>WinExe</OutputType>
    <RootNamespace>CodexBar.WinUI</RootNamespace>
    <!-- Must stay CodexBar.WinUI: CodexBar.Core grants InternalsVisibleTo to this name. -->
    <AssemblyName>CodexBar.WinUI</AssemblyName>

    <!-- WinUI 3, UNPACKAGED (no MSIX: it needs signing and breaks the self-updater). -->
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <EnableMsixTooling>false</EnableMsixTooling>

    <!-- Custom entry point (Program.Main) instead of the XAML-generated one. -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>

    <!-- Self-contained: the Windows App Runtime ships next to the exe, so the
         installer needs no runtime prerequisite. -->
    <SelfContained>true</SelfContained>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Platforms>x64</Platforms>
    <UseRidGraph>true</UseRidGraph>

    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\Assets\CodexBarWindows.ico</ApplicationIcon>

    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260710003" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.7175" />
    <PackageReference Include="H.NotifyIcon.WinUI" Version="2.4.1" />
    <!-- SettingsCard / SettingsExpander: the idiomatic Windows 11 settings surface. Verified
         to restore, compile AND run unpackaged against WindowsAppSDK 1.8 before it was adopted. -->
    <PackageReference Include="CommunityToolkit.WinUI.Controls.SettingsControls" Version="8.2.251219" />
    <!-- Charts for the Usage graphs window. Verified to render UNPACKAGED; it costs ~0.5s of
         Skia init on the first render in a process, which App pays off-screen at startup. -->
    <PackageReference Include="LiveChartsCore.SkiaSharpView.WinUI" Version="2.0.5" />
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CodexBar.Core\CodexBar.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- One shared icon file for both apps; copied into Assets\ next to the exe. -->
    <Content Include="..\Assets\CodexBarWindows.ico" Link="Assets\CodexBarWindows.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <!--
    WITHOUT THIS TARGET THE PUBLISHED APP CRASHES. `dotnet publish` on this unpackaged WinUI 3
    project silently drops exactly two of the build outputs: this project's own compiled resource
    index (CodexBar.WinUI.pri) and App.xbf. Every OTHER .pri is published (Microsoft.UI.pri,
    Microsoft.UI.Xaml.Controls.pri, Microsoft.WindowsAppRuntime.pri), which is what makes the
    omission so easy to miss - the publish output looks complete and the app even STARTS.

    The failure it produces is not a missing-file error. The process launches, runs everything
    that does not touch a XAML tree of ours, and then fail-fasts with 0xC0000409
    (STATUS_STACK_BUFFER_OVERRUN) the moment the first x:Class window is constructed. It was
    diagnosed by diffing the publish folder against the build folder - 538 files against 543 -
    and confirmed by copying just these two files in by hand, after which the same publish ran
    correctly.
  -->
  <Target Name="PublishWinUiResourceIndex" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <_WinUiPublishExtras Include="$(TargetDir)$(TargetName).pri" />
      <_WinUiPublishExtras Include="$(TargetDir)*.xbf" />
      <!-- Idempotent: if a future Windows App SDK starts publishing these itself, the entries it
           added are dropped here and re-added once, rather than duplicated. -->
      <ResolvedFileToPublish Remove="@(_WinUiPublishExtras)" />
      <ResolvedFileToPublish Include="@(_WinUiPublishExtras)">
        <RelativePath>%(Filename)%(Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

</Project>
