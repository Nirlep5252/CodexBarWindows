<?xml version="1.0" encoding="UTF-8" ?>
<Window
    x:Class="CodexBar.WinUI.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:tk="using:CommunityToolkit.WinUI.Controls">

    <!--
      The WinForms SettingsForm painted every card, expander, toggle, slider, combo box and
      list row by hand (FluentControls.cs). Every one of those is a stock control here:
      NavigationView for the rail, the Windows Community Toolkit SettingsCard / SettingsExpander
      for the rows, and ToggleSwitch / ComboBox / Slider / TextBox for the values. Nothing in
      this file draws anything.
    -->
    <Grid x:Name="RootGrid" Background="Transparent">
        <Border x:Name="TintLayer" />

        <NavigationView
            x:Name="Nav"
            Background="Transparent"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="False"
            IsSettingsVisible="False"
            OpenPaneLength="196"
            PaneDisplayMode="Left"
            SelectionChanged="OnNavSelectionChanged">

            <NavigationView.MenuItems>
                <NavigationViewItem Content="General" Tag="general">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE770;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Appearance" Tag="appearance">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE790;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Codex accounts" Tag="accounts">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE716;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Cursor" Tag="cursor">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE774;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <Grid>

                <!-- ======================================================= General -->
                <ScrollViewer x:Name="GeneralPage" Padding="28,0,28,28">
                    <StackPanel MaxWidth="720" Spacing="4">
                        <TextBlock
                            Margin="0,18,0,12"
                            Style="{StaticResource TitleTextBlockStyle}"
                            Text="General" />

                        <tk:SettingsCard
                            Description="Launch CodexBar automatically when you sign in"
                            Header="Start with Windows">
                            <tk:SettingsCard.HeaderIcon>
                                <FontIcon Glyph="&#xE7E8;" />
                            </tk:SettingsCard.HeaderIcon>
                            <ToggleSwitch x:Name="StartupToggle" AutomationProperties.Name="Start with Windows" />
                        </tk:SettingsCard>

                        <tk:SettingsCard x:Name="VersionCard" Header="Version">
                            <tk:SettingsCard.HeaderIcon>
                                <FontIcon Glyph="&#xE946;" />
                            </tk:SettingsCard.HeaderIcon>
                            <Button x:Name="CheckUpdatesButton" Content="Check for updates" />
                        </tk:SettingsCard>

                        <InfoBar
                            x:Name="UpdateInfoBar"
                            Margin="0,4,0,0"
                            IsClosable="True"
                            IsOpen="False"
                            Severity="Informational" />

                        <TextBlock
                            Margin="2,20,0,6"
                            Style="{StaticResource BodyStrongTextBlockStyle}"
                            Text="Tools" />
                        <TextBlock
                            Margin="2,0,0,8"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="A tool you turn off loses its tab in the flyout and is never polled." />

                        <tk:SettingsCard
                            x:Name="CodexEnabledCard"
                            Description="Show Codex usage and poll the Codex CLI"
                            Header="Codex">
                            <tk:SettingsCard.HeaderIcon>
                                <FontIcon Glyph="&#xE90F;" />
                            </tk:SettingsCard.HeaderIcon>
                            <ToggleSwitch x:Name="CodexEnabledToggle" AutomationProperties.Name="Codex enabled" />
                        </tk:SettingsCard>

                        <tk:SettingsCard
                            x:Name="ClaudeEnabledCard"
                            Description="Show Claude usage and read Claude Code session data"
                            Header="Claude">
                            <tk:SettingsCard.HeaderIcon>
                                <FontIcon Glyph="&#xE90F;" />
                            </tk:SettingsCard.HeaderIcon>
                            <ToggleSwitch x:Name="ClaudeEnabledToggle" AutomationProperties.Name="Claude enabled" />
                        </tk:SettingsCard>

                        <tk:SettingsCard
                            x:Name="CursorEnabledCard"
                            Description="Show Cursor usage"
                            Header="Cursor">
                            <tk:SettingsCard.HeaderIcon>
                                <FontIcon Glyph="&#xE90F;" />
                            </tk:SettingsCard.HeaderIcon>
                            <ToggleSwitch x:Name="CursorEnabledToggle" AutomationProperties.Name="Cursor enabled" />
                        </tk:SettingsCard>

                        <InfoBar
                            x:Name="ToolsInfoBar"
                            Margin="0,8,0,0"
                            IsClosable="False"
                            IsOpen="False"
                            Message="At least one tool has to stay on, so Codex was turned back on."
                            Severity="Informational" />
                    </StackPanel>
                </ScrollViewer>

                <!-- ==================================================== Appearance -->
                <ScrollViewer x:Name="AppearancePage" Padding="28,0,28,28" Visibility="Collapsed">
                    <StackPanel MaxWidth="720" Spacing="4">
                        <TextBlock
                            Margin="0,18,0,12"
                            Style="{StaticResource TitleTextBlockStyle}"
                            Text="Appearance" />

                        <tk:SettingsCard Description="Choose how CodexBar looks" Header="Theme">
                            <tk:SettingsCard.HeaderIcon>
                                <FontIcon Glyph="&#xE790;" />
                            </tk:SettingsCard.HeaderIcon>
                            <ComboBox x:Name="ThemeCombo" MinWidth="180" AutomationProperties.Name="Theme">
                                <ComboBoxItem Content="System default" />
                                <ComboBoxItem Content="Light" />
                                <ComboBoxItem Content="Dark" />
                            </ComboBox>
                        </tk:SettingsCard>

                        <!-- Expander, not a card: the tint slider only makes sense next to the
                             material it tints, and it is the one control here that is disabled
                             by another control's value. -->
                        <tk:SettingsExpander
                            x:Name="MaterialExpander"
                            Description="Select the visual material used behind the flyout"
                            Header="Material"
                            IsExpanded="True">
                            <tk:SettingsExpander.HeaderIcon>
                                <FontIcon Glyph="&#xE771;" />
                            </tk:SettingsExpander.HeaderIcon>
                            <ComboBox x:Name="MaterialCombo" MinWidth="180" AutomationProperties.Name="Material">
                                <ComboBoxItem Content="Acrylic (default)" />
                                <ComboBoxItem Content="Mica" />
                                <ComboBoxItem Content="Mica Alt" />
                                <ComboBoxItem Content="Solid" />
                            </ComboBox>

                            <tk:SettingsExpander.Items>
                                <tk:SettingsCard x:Name="OpacityRow" Description="Background tint strength" Header="Opacity">
                                    <StackPanel
                                        Orientation="Horizontal"
                                        Spacing="12"
                                        VerticalAlignment="Center">
                                        <Slider
                                            x:Name="OpacitySlider"
                                            Width="220"
                                            AutomationProperties.Name="Tint opacity"
                                            Maximum="100"
                                            Minimum="0"
                                            StepFrequency="1"
                                            VerticalAlignment="Center" />
                                        <TextBlock
                                            x:Name="OpacityValueText"
                                            MinWidth="34"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            TextAlignment="Right"
                                            VerticalAlignment="Center" />
                                    </StackPanel>
                                </tk:SettingsCard>
                            </tk:SettingsExpander.Items>
                        </tk:SettingsExpander>

                        <tk:SettingsCard
                            Description="V3 Code theme, animated meters, and little celebrations."
                            Header="Turn on the vibes">
                            <tk:SettingsCard.HeaderIcon>
                                <FontIcon Glyph="&#xE945;" />
                            </tk:SettingsCard.HeaderIcon>
                            <ToggleSwitch x:Name="VibesToggle" AutomationProperties.Name="Vibes" />
                        </tk:SettingsCard>
                    </StackPanel>
                </ScrollViewer>

                <!-- ================================================ Codex accounts -->
                <ScrollViewer x:Name="AccountsPage" Padding="28,0,28,28" Visibility="Collapsed">
                    <StackPanel MaxWidth="720" Spacing="4">
                        <TextBlock
                            Margin="0,18,0,4"
                            Style="{StaticResource TitleTextBlockStyle}"
                            Text="Codex accounts" />
                        <TextBlock
                            Margin="2,0,0,12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="Add another authenticated CLI binary or wrapper script for each extra account. Each one gets its own tab in the flyout."
                            TextWrapping="Wrap" />

                        <InfoBar
                            x:Name="AccountsInfoBar"
                            Margin="0,0,0,8"
                            IsClosable="True"
                            IsOpen="False"
                            Severity="Warning" />

                        <!-- The built-in account is always present and is not editable, so it is
                             declared here rather than generated - which also keeps its secondary
                             text on a {ThemeResource} instead of a code-side brush lookup. -->
                        <tk:SettingsCard
                            x:Name="BuiltInAccountCard"
                            Description="Resolved from PATH. This is the account the Codex CLI itself is signed in to."
                            Header="Codex">
                            <tk:SettingsCard.HeaderIcon>
                                <FontIcon Glyph="&#xE77B;" />
                            </tk:SettingsCard.HeaderIcon>
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="Built in" />
                        </tk:SettingsCard>

                        <!-- The extra accounts are built in code (RenderAccounts): one
                             SettingsExpander each, with its editor inline in the expanded body. -->
                        <StackPanel x:Name="AccountList" Spacing="4" />

                        <tk:SettingsExpander
                            x:Name="AddAccountExpander"
                            Margin="0,12,0,0"
                            Description="Point CodexBar at a second signed-in codex.exe, codex.cmd or wrapper script"
                            Header="Add an account">
                            <tk:SettingsExpander.HeaderIcon>
                                <FontIcon Glyph="&#xE710;" />
                            </tk:SettingsExpander.HeaderIcon>
                            <tk:SettingsExpander.Items>
                                <tk:SettingsCard HorizontalContentAlignment="Stretch" ContentAlignment="Vertical">
                                    <StackPanel Spacing="10">
                                        <TextBox
                                            x:Name="AddNameBox"
                                            AutomationProperties.Name="New account name"
                                            Header="Display name"
                                            PlaceholderText="Name shown in the flyout" />
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox
                                                x:Name="AddPathBox"
                                                AutomationProperties.Name="New account binary path"
                                                Header="Codex binary path"
                                                PlaceholderText="codex.exe, codex.cmd, or wrapper path" />
                                            <Button
                                                x:Name="AddBrowseButton"
                                                Grid.Column="1"
                                                Content="Browse"
                                                VerticalAlignment="Bottom" />
                                        </Grid>
                                        <Button
                                            x:Name="AddAccountButton"
                                            Content="Add account"
                                            HorizontalAlignment="Left"
                                            Style="{StaticResource AccentButtonStyle}" />
                                    </StackPanel>
                                </tk:SettingsCard>
                            </tk:SettingsExpander.Items>
                        </tk:SettingsExpander>
                    </StackPanel>
                </ScrollViewer>

                <!-- ======================================================== Cursor -->
                <ScrollViewer x:Name="CursorPage" Padding="28,0,28,28" Visibility="Collapsed">
                    <StackPanel MaxWidth="720" Spacing="4">
                        <TextBlock
                            Margin="0,18,0,4"
                            Style="{StaticResource TitleTextBlockStyle}"
                            Text="Cursor" />
                        <TextBlock
                            Margin="2,0,0,12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="Paste a Cookie header from any cursor.com request to show Cursor usage. It is stored encrypted for your Windows account (DPAPI)."
                            TextWrapping="Wrap" />

                        <InfoBar
                            x:Name="CursorInfoBar"
                            Margin="0,0,0,8"
                            IsClosable="True"
                            IsOpen="False"
                            Severity="Warning" />

                        <tk:SettingsExpander
                            x:Name="CursorExpander"
                            Header="Cookie header"
                            IsExpanded="True">
                            <tk:SettingsExpander.HeaderIcon>
                                <FontIcon Glyph="&#xE72E;" />
                            </tk:SettingsExpander.HeaderIcon>
                            <tk:SettingsExpander.Items>
                                <tk:SettingsCard HorizontalContentAlignment="Stretch" ContentAlignment="Vertical">
                                    <StackPanel Spacing="10">
                                        <!-- A PasswordBox, not a TextBox: this is a live session
                                             credential, and the WinForms field rendered it in
                                             full on screen. Peek keeps the reveal button so it
                                             can still be checked deliberately. -->
                                        <PasswordBox
                                            x:Name="CursorCookieBox"
                                            AutomationProperties.Name="Cursor cookie header"
                                            PasswordRevealMode="Peek"
                                            PlaceholderText="Cookie: WorkosCursorSessionToken=..." />
                                        <TextBlock
                                            x:Name="CursorSavedText"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Style="{StaticResource CaptionTextBlockStyle}" />
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Button
                                                x:Name="SaveCursorButton"
                                                Content="Save"
                                                Style="{StaticResource AccentButtonStyle}" />
                                            <Button x:Name="ClearCursorButton" Content="Clear" />
                                        </StackPanel>
                                    </StackPanel>
                                </tk:SettingsCard>
                            </tk:SettingsExpander.Items>
                        </tk:SettingsExpander>
                    </StackPanel>
                </ScrollViewer>

            </Grid>
        </NavigationView>
    </Grid>
</Window>
