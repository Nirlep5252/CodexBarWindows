<?xml version="1.0" encoding="UTF-8" ?>
<Window
    x:Class="CodexBar.WinUI.GraphsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:CodexBar.WinUI"
    xmlns:lvc="using:LiveChartsCore.SkiaSharpView.WinUI">

    <!--
      The WinForms UsageGraphsForm hand-painted both charts with GDI+ (bars, gridlines, axis
      labels, legend, hover highlight, tooltips and entrance animations - roughly 1200 of its
      2072 lines). Here the daily chart is a LiveCharts2 CartesianChart and the code-behind only
      shapes data into series; the per-model chart is gone entirely, replaced by the flyout's own
      usage-row anatomy (label, inline meter, cost, tokens).

      The chrome deliberately mirrors FlyoutWindow so the two surfaces read as one app: the same
      RootGrid/TintLayer backdrop pair, the same 16,12,16,12 padding with a single RowSpacing
      instead of hand-written per-child margins, the same CornerRadius=8 cards, the same
      caption-scale type ramp, the same "  ·  " separator idiom, the same subtle icon button, and
      ONE status line at the bottom carrying freshness.

      The window is four stacked cards now - timeline, metrics, chart, model rows - because it is a
      time EXPLORER rather than a fixed 30-day report: the strip in row 1 moves the period, and the
      chart's columns are clickable to retarget the breakdown below.
    -->
    <Grid x:Name="RootGrid" Background="Transparent">

        <Grid.KeyboardAccelerators>
            <!-- Esc clears a drill-down and NOTHING else. It is deliberately not a close: this
                 window keeps its system title bar and is not a dismissable flyout, so a stray Esc
                 that closed it would cost the user their scan. See OnEscapeAccelerator. -->
            <KeyboardAccelerator Key="Escape" Invoked="OnEscapeAccelerator" />
        </Grid.KeyboardAccelerators>

        <Grid.Resources>
            <!--
              Colours live on STYLES, never on brushes assigned in code-behind: a brush read out of
              Application.Current.Resources resolves against the APP theme (which nothing here ever
              sets) and is captured once, so it renders wrong under a forced theme and never
              follows a live system flip. Style setters re-resolve per element against ActualTheme.
              The only code-assigned colours on this window come from ChartPalette, which is
              rebuilt on ActualThemeChanged for exactly the same reason.
            -->
            <Style x:Key="GraphCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <!-- 8, not ControlCornerRadius: the flyout's cards are explicitly 8 and the two
                     surfaces have to belong to the same card family. -->
                <Setter Property="CornerRadius" Value="8" />
            </Style>

            <Style x:Key="CardSeparatorStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="Width" Value="1" />
            </Style>

            <!-- The whole secondary vocabulary is caption-scale, as in the flyout. Muting is done
                 with a style rather than an inline brush so that RenderStatus/RenderError can
                 override Foreground for a warning and ClearValue back to muted rather than to
                 TextBlock's default primary colour. -->
            <Style
                x:Key="SecondaryCaptionStyle"
                BasedOn="{StaticResource CaptionTextBlockStyle}"
                TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>

            <Style
                x:Key="TertiaryCaptionStyle"
                BasedOn="{StaticResource CaptionTextBlockStyle}"
                TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}" />
            </Style>

            <!--
              The model row. Fixed columns for the same reason the flyout's rows have them: a row
              whose label column sizes to content makes every meter start at a different x, and the
              rows stop reading as a single comparable set. Trimmed text keeps its full form on the
              row tooltip (DetailText).
            -->
            <DataTemplate x:Key="ModelRowTemplate" x:DataType="local:ModelRowModel">
                <Grid
                    ColumnSpacing="9"
                    Padding="0,4,0,4"
                    ToolTipService.ToolTip="{x:Bind DetailText, Mode=OneWay}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="118" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="64" />
                        <ColumnDefinition Width="76" />
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        MaxLines="1"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{x:Bind Name, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis"
                        VerticalAlignment="Center" />

                    <ProgressBar
                        Grid.Column="1"
                        Height="4"
                        Foreground="{x:Bind ColorBrush, Mode=OneWay}"
                        Maximum="100"
                        Minimum="0"
                        MinWidth="60"
                        Value="{x:Bind MeterValue, Mode=OneWay}"
                        VerticalAlignment="Center" />

                    <TextBlock
                        Grid.Column="2"
                        FontWeight="SemiBold"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{x:Bind CostText, Mode=OneWay}"
                        TextAlignment="Right"
                        VerticalAlignment="Center" />

                    <TextBlock
                        Grid.Column="3"
                        MaxLines="1"
                        Style="{StaticResource TertiaryCaptionStyle}"
                        Text="{x:Bind TokensText, Mode=OneWay}"
                        TextAlignment="Right"
                        TextTrimming="CharacterEllipsis"
                        VerticalAlignment="Center" />
                </Grid>
            </DataTemplate>
        </Grid.Resources>

        <Border x:Name="TintLayer" />

        <Grid Padding="16,12,16,12" RowSpacing="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <!-- The chart is still the point of this window, so it takes the larger star. The
                     minimums are what the enforced minimum window size (see MinimumWidth/Height in
                     the code-behind) is derived from: below them the chart has no plot area left
                     once its axis labels and legend are drawn, and the row card cannot show five
                     rows. -->
                <RowDefinition Height="3*" MinHeight="150" />
                <RowDefinition Height="2*" MinHeight="128" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ============================================================ header -->
            <!-- One line: title left, actions right - the flyout's header, minus the buttons that
                 do not apply. Close is absent because this window keeps its system title bar. -->
            <Grid Grid.Row="0" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    Grid.Column="0"
                    MaxLines="1"
                    Style="{StaticResource SubtitleTextBlockStyle}"
                    Text="Usage graphs"
                    TextTrimming="CharacterEllipsis"
                    VerticalAlignment="Center" />

                <!-- Sized to its content rather than pinned at 200: with two to four accounts a
                     fixed-width dropdown floating at the right of the header is the WinForms
                     toolbar idiom the rest of this window just lost. -->
                <ComboBox
                    x:Name="ProviderCombo"
                    Grid.Column="1"
                    Height="32"
                    MaxWidth="220"
                    AutomationProperties.Name="Provider"
                    SelectionChanged="OnProviderSelectionChanged"
                    ToolTipService.ToolTip="Provider"
                    VerticalAlignment="Center" />

                <!-- The manual refresh the WinForms port never had; F5 matches the flyout. The
                     glyph swaps for a ring IN PLACE while busy, so the chrome never reflows. -->
                <Button
                    x:Name="RefreshButton"
                    Grid.Column="2"
                    Width="34"
                    Height="32"
                    Padding="0"
                    AutomationProperties.Name="Refresh"
                    Click="OnRefreshClick"
                    Style="{StaticResource SubtleButtonStyle}"
                    ToolTipService.ToolTip="Refresh (F5)"
                    VerticalAlignment="Center">
                    <Button.KeyboardAccelerators>
                        <KeyboardAccelerator Key="F5" />
                    </Button.KeyboardAccelerators>
                    <Grid>
                        <FontIcon x:Name="RefreshGlyph" FontSize="15" Glyph="&#xE72C;" />
                        <ProgressRing
                            x:Name="RefreshSpinner"
                            Width="16"
                            Height="16"
                            IsActive="False"
                            Visibility="Collapsed" />
                    </Grid>
                </Button>
            </Grid>

            <!-- ===================================================== timeline strip -->
            <!--
              A CARD, not a toolbar: the window reads as four stacked cards in the flyout's 8-radius
              family, and a bare row of buttons floating above the first card would read as chrome
              belonging to the header. The label slot is fixed-width and centred so the arrows do
              not jitter as the label text changes width between granularities, and the jump button
              keeps a 32-wide slot whether or not it is showing so the SelectorBar never moves.
            -->
            <Border
                Grid.Row="1"
                Padding="6,4,6,4"
                Style="{StaticResource GraphCardStyle}">
                <Grid ColumnSpacing="6" MinHeight="32">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="32" />
                    </Grid.ColumnDefinitions>

                    <!-- DISABLED at the ends of history, never hidden: hiding an arrow would slide
                         the period label out from under the pointer mid-navigation. -->
                    <Button
                        x:Name="PrevPeriodButton"
                        Grid.Column="0"
                        Width="30"
                        Height="28"
                        Padding="0"
                        AutomationProperties.Name="Previous period"
                        Click="OnPreviousPeriod"
                        Style="{StaticResource SubtleButtonStyle}"
                        VerticalAlignment="Center">
                        <FontIcon FontSize="13" Glyph="&#xE76B;" />
                    </Button>

                    <TextBlock
                        x:Name="PeriodLabelText"
                        Grid.Column="1"
                        HorizontalAlignment="Center"
                        MaxLines="1"
                        MinWidth="150"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="--"
                        TextAlignment="Center"
                        TextTrimming="CharacterEllipsis"
                        VerticalAlignment="Center" />

                    <Button
                        x:Name="NextPeriodButton"
                        Grid.Column="2"
                        Width="30"
                        Height="28"
                        Padding="0"
                        AutomationProperties.Name="Next period"
                        Click="OnNextPeriod"
                        Style="{StaticResource SubtleButtonStyle}"
                        VerticalAlignment="Center">
                        <FontIcon FontSize="13" Glyph="&#xE76C;" />
                    </Button>

                    <StackPanel
                        Grid.Column="3"
                        Orientation="Horizontal"
                        Spacing="8"
                        VerticalAlignment="Center">
                        <!-- Shown only while the ledger cannot reach as far back as the logs on
                             disk do, and gone for good once an import has run. No banner, no
                             InfoBar - both were deliberately removed from all three windows. -->
                        <HyperlinkButton
                            x:Name="ImportHistoryLink"
                            Padding="4,0,4,0"
                            Click="OnImportHistoryClick"
                            Content="Import history"
                            FontSize="12"
                            ToolTipService.ToolTip="Import older sessions from Settings ▸ Graphs"
                            Visibility="Collapsed" />

                        <!-- A SelectorBar, matching the settings surface, rather than a Segmented or
                             RadioButtons control. Year is declared FIRST so the visible order reads
                             Month | Week | Day, and ships collapsed: only 2026 exists, so a year
                             bucket would be a single column. Its data path is fully wired. -->
                        <SelectorBar
                            x:Name="GranularityBar"
                            AutomationProperties.Name="Granularity"
                            SelectionChanged="OnGranularityChanged">
                            <SelectorBarItem
                                x:Name="GranularityYear"
                                Tag="year"
                                Text="Year"
                                Visibility="Collapsed" />
                            <SelectorBarItem
                                x:Name="GranularityMonth"
                                Tag="month"
                                Text="Month" />
                            <SelectorBarItem
                                x:Name="GranularityWeek"
                                Tag="week"
                                Text="Week" />
                            <SelectorBarItem
                                x:Name="GranularityDay"
                                Tag="day"
                                Text="Day" />
                        </SelectorBar>
                    </StackPanel>

                    <Button
                        x:Name="JumpToNowButton"
                        Grid.Column="4"
                        Width="30"
                        Height="28"
                        Padding="0"
                        AutomationProperties.Name="Jump to the current period"
                        Click="OnJumpToNow"
                        Style="{StaticResource SubtleButtonStyle}"
                        ToolTipService.ToolTip="Jump to the current period"
                        VerticalAlignment="Center"
                        Visibility="Collapsed">
                        <FontIcon FontSize="13" Glyph="&#xE823;" />
                    </Button>
                </Grid>
            </Border>

            <!-- ========================================================= metric row -->
            <!--
              Four cells in one card, reusing the previous summary strip's anatomy verbatim: a
              tertiary label line, then the figure with an ellipsising detail beside it. Same
              hairline separators, same type ramp - only the number of cells changed, because the
              two fixed windows ("Today", "Last 30 days") became four facts about whichever period
              the strip above is pointing at.
            -->
            <Border
                Grid.Row="2"
                Padding="12,8,12,8"
                Style="{StaticResource GraphCardStyle}">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Spacing="1">
                        <TextBlock
                            x:Name="TotalLabelText"
                            MaxLines="1"
                            Style="{StaticResource TertiaryCaptionStyle}"
                            Text="Total"
                            TextTrimming="CharacterEllipsis" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                x:Name="TotalValueText"
                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                Text="--" />
                            <TextBlock
                                x:Name="TotalDetailText"
                                Grid.Column="1"
                                MaxLines="1"
                                Margin="0,0,0,1"
                                Style="{StaticResource SecondaryCaptionStyle}"
                                Text=""
                                TextTrimming="CharacterEllipsis"
                                VerticalAlignment="Bottom" />
                        </Grid>
                    </StackPanel>

                    <Border
                        Grid.Column="1"
                        Margin="0,2,0,2"
                        Style="{StaticResource CardSeparatorStyle}" />

                    <StackPanel Grid.Column="2" Spacing="1">
                        <TextBlock
                            x:Name="DeltaLabelText"
                            MaxLines="1"
                            Style="{StaticResource TertiaryCaptionStyle}"
                            Text="vs previous month"
                            TextTrimming="CharacterEllipsis" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                x:Name="DeltaValueText"
                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                Text="--" />
                            <TextBlock
                                x:Name="DeltaDetailText"
                                Grid.Column="1"
                                MaxLines="1"
                                Margin="0,0,0,1"
                                Style="{StaticResource SecondaryCaptionStyle}"
                                Text=""
                                TextTrimming="CharacterEllipsis"
                                VerticalAlignment="Bottom" />
                        </Grid>
                    </StackPanel>

                    <Border
                        Grid.Column="3"
                        Margin="0,2,0,2"
                        Style="{StaticResource CardSeparatorStyle}" />

                    <StackPanel Grid.Column="4" Spacing="1">
                        <TextBlock
                            x:Name="AverageLabelText"
                            MaxLines="1"
                            Style="{StaticResource TertiaryCaptionStyle}"
                            Text="Average / day"
                            TextTrimming="CharacterEllipsis" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                x:Name="AverageValueText"
                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                Text="--" />
                            <TextBlock
                                x:Name="AverageDetailText"
                                Grid.Column="1"
                                MaxLines="1"
                                Margin="0,0,0,1"
                                Style="{StaticResource SecondaryCaptionStyle}"
                                Text=""
                                TextTrimming="CharacterEllipsis"
                                VerticalAlignment="Bottom" />
                        </Grid>
                    </StackPanel>

                    <Border
                        Grid.Column="5"
                        Margin="0,2,0,2"
                        Style="{StaticResource CardSeparatorStyle}" />

                    <!-- ADAPTIVE: "Projected" while the period is the current one, "Peak day" once
                         it is complete. A dead placeholder "Projected" on every historical period would
                         waste a quarter of the row during the very navigation this window exists
                         for. -->
                    <StackPanel Grid.Column="6" Spacing="1">
                        <TextBlock
                            x:Name="OutlookLabelText"
                            MaxLines="1"
                            Style="{StaticResource TertiaryCaptionStyle}"
                            Text="Projected"
                            TextTrimming="CharacterEllipsis" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                x:Name="OutlookValueText"
                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                Text="--" />
                            <TextBlock
                                x:Name="OutlookDetailText"
                                Grid.Column="1"
                                MaxLines="1"
                                Margin="0,0,0,1"
                                Style="{StaticResource SecondaryCaptionStyle}"
                                Text=""
                                TextTrimming="CharacterEllipsis"
                                VerticalAlignment="Bottom" />
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ============================================================= error -->
            <!--
              The InfoBar is gone: a full-width banner with its own Copy button pushed the charts
              down every time it opened. This is the flyout's treatment instead - a 12px glyph and
              caption text in place, in the palette's warning or danger colour, WRAPPED and never
              ellipsised, with the full text on the tooltip and on a right-click Copy, plus text
              selection. Nothing about the message is lost; only the chrome is.
            -->
            <Grid
                x:Name="ErrorPanel"
                Grid.Row="3"
                ColumnSpacing="6"
                Padding="2,0,2,0"
                IsTabStop="True"
                UseSystemFocusVisuals="True"
                Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.KeyboardAccelerators>
                    <KeyboardAccelerator Modifiers="Control" Key="C" Invoked="OnCopyErrorAccelerator" />
                </Grid.KeyboardAccelerators>
                <Grid.ContextFlyout>
                    <MenuFlyout>
                        <MenuFlyoutItem
                            MinWidth="140"
                            Text="Copy"
                            Click="OnCopyError" />
                    </MenuFlyout>
                </Grid.ContextFlyout>

                <FontIcon
                    x:Name="ErrorIcon"
                    Margin="0,2,0,0"
                    FontSize="12"
                    Glyph="&#xE7BA;"
                    VerticalAlignment="Top" />
                <!-- MaxLines, not free growth: this row is Auto in a NON-scrolling grid, so a
                     long provider error grew until it pushed the status line - and eventually the
                     chart - off the bottom of the window. Four lines is generous for a message,
                     and the full text stays on the tooltip, selectable, and one Ctrl+C away. -->
                <TextBlock
                    x:Name="ErrorText"
                    Grid.Column="1"
                    IsTextSelectionEnabled="True"
                    MaxLines="4"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="Wrap" />

                <Button
                    Grid.Column="2"
                    Padding="8,2,8,2"
                    AutomationProperties.Name="Copy error"
                    Click="OnCopyError"
                    Content="Copy"
                    FontSize="12"
                    MinWidth="0"
                    MinHeight="0"
                    Style="{StaticResource SubtleButtonStyle}"
                    ToolTipService.ToolTip="Copy the full error (Ctrl+C)"
                    VerticalAlignment="Top" />
            </Grid>

            <!-- ======================================================= daily chart -->
            <Border
                Grid.Row="4"
                Padding="12,8,12,10"
                Style="{StaticResource GraphCardStyle}">
                <Grid RowSpacing="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Caption scale, not BodyStrong: in the flyout BodyStrong names a PROVIDER
                         inside a card header, and this is a section label. The text follows the
                         granularity ("by day" / "by hour" / "by month"). -->
                    <TextBlock
                        x:Name="ChartHeadingText"
                        Grid.Row="0"
                        MaxLines="1"
                        Style="{StaticResource SecondaryCaptionStyle}"
                        Text="Estimated spend by day"
                        TextTrimming="CharacterEllipsis" />

                    <Grid Grid.Row="1">
                        <!-- Transparent: the chart control's own background defaults to an
                             opaque black, which would punch a hole in the card. -->
                        <lvc:CartesianChart x:Name="DailyChart" Background="Transparent" />
                        <StackPanel
                            x:Name="DailyOverlay"
                            HorizontalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="8"
                            VerticalAlignment="Center"
                            Visibility="Collapsed">
                            <ProgressRing
                                x:Name="DailyOverlayRing"
                                Width="16"
                                Height="16"
                                IsActive="False"
                                Visibility="Collapsed" />
                            <TextBlock
                                x:Name="DailyOverlayText"
                                Style="{StaticResource TertiaryCaptionStyle}"
                                VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- ======================================================== model rows -->
            <!--
              The horizontal RowSeries chart is gone. It spent a whole Skia control, an axis, a
              tooltip and a per-row colour nudge to say what four aligned columns say better - and
              it could not show tokens beside cost at all. This is the flyout's usage-row anatomy,
              so the two windows now share one vocabulary for "a thing with a share of a total".
            -->
            <Border
                Grid.Row="5"
                Padding="12,8,12,10"
                Style="{StaticResource GraphCardStyle}">
                <Grid RowSpacing="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            MaxLines="1"
                            Style="{StaticResource SecondaryCaptionStyle}"
                            Text="Spend by model"
                            TextTrimming="CharacterEllipsis" />

                        <!-- The scope caption and the drill-down chip share ONE cell with their
                             visibility swapped, so entering and leaving a drill-down does not move
                             the card heading. -->
                        <Grid Grid.Column="1">
                            <TextBlock
                                x:Name="ModelScopeText"
                                MaxLines="1"
                                Style="{StaticResource TertiaryCaptionStyle}"
                                Text=""
                                TextTrimming="CharacterEllipsis"
                                VerticalAlignment="Center" />
                            <Button
                                x:Name="ModelScopeChip"
                                Padding="8,2,8,2"
                                AutomationProperties.Name="Show the whole period"
                                Click="OnClearSelection"
                                FontSize="12"
                                MinWidth="0"
                                MinHeight="0"
                                Style="{StaticResource SubtleButtonStyle}"
                                ToolTipService.ToolTip="Show the whole period (Esc)"
                                VerticalAlignment="Center"
                                Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock
                                        x:Name="ModelScopeChipText"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        VerticalAlignment="Center" />
                                    <FontIcon FontSize="10" Glyph="&#xE711;" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Grid>

                    <ScrollViewer
                        Grid.Row="1"
                        HorizontalScrollMode="Disabled"
                        Padding="0,0,4,0"
                        VerticalScrollBarVisibility="Auto">
                        <Grid>
                            <ItemsControl x:Name="ModelRows" ItemTemplate="{StaticResource ModelRowTemplate}" />

                            <!-- The settings page's empty-card treatment, inline: there is no chart
                                 left in this card to fade behind an overlay. -->
                            <StackPanel
                                x:Name="ModelEmptyPanel"
                                HorizontalAlignment="Center"
                                Padding="16,16,16,16"
                                Spacing="6"
                                VerticalAlignment="Center"
                                Visibility="Collapsed">
                                <ProgressRing
                                    x:Name="ModelBusyRing"
                                    Width="16"
                                    Height="16"
                                    HorizontalAlignment="Center"
                                    IsActive="False"
                                    Visibility="Collapsed" />
                                <FontIcon
                                    x:Name="ModelEmptyGlyph"
                                    FontSize="20"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                    Glyph="&#xE9D2;"
                                    HorizontalAlignment="Center" />
                                <TextBlock
                                    x:Name="ModelEmptyTitle"
                                    HorizontalAlignment="Center"
                                    Style="{StaticResource SecondaryCaptionStyle}"
                                    Text="" />
                                <TextBlock
                                    x:Name="ModelEmptyDetail"
                                    HorizontalAlignment="Center"
                                    Style="{StaticResource TertiaryCaptionStyle}"
                                    Text=""
                                    TextAlignment="Center"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- ======================================================= status line -->
            <!--
              The one persistent line every surface in this app ends with: freshness and source
              only ("Local estimates  ·  updated 4 min ago"). It used to be a header subtitle
              crammed under the title. Wrapped to three lines, full text on the tooltip and on a
              right-click Copy; the warning glyph appears only when the data is stale.
            -->
            <Grid
                Grid.Row="6"
                ColumnSpacing="6"
                Padding="2,0,2,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.ContextFlyout>
                    <MenuFlyout>
                        <MenuFlyoutItem
                            MinWidth="140"
                            Text="Copy"
                            Click="OnCopyStatus" />
                    </MenuFlyout>
                </Grid.ContextFlyout>

                <FontIcon
                    x:Name="StatusIcon"
                    Margin="0,1,0,0"
                    FontSize="12"
                    Glyph="&#xE7BA;"
                    Visibility="Collapsed"
                    VerticalAlignment="Top" />
                <TextBlock
                    x:Name="StatusText"
                    Grid.Column="1"
                    MaxLines="3"
                    Style="{StaticResource TertiaryCaptionStyle}"
                    Text="Local session estimates"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="Wrap" />
            </Grid>
        </Grid>
    </Grid>
</Window>
